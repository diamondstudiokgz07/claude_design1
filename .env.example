# --- Домены (Caddy) ---
API_DOMAIN=api.dostuk.kg
MENU_DOMAIN=menu.dostuk.kg
FILES_DOMAIN=files.dostuk.kg

# --- PostgreSQL ---
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
# Приложение — роль без BYPASSRLS; миграции — владелец схемы
DOSTUK_DATABASE_URL=postgresql+asyncpg://dostuk_app:change-me-app@postgres:5432/dostuk
DOSTUK_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://dostuk:change-me-owner@postgres:5432/dostuk

DOSTUK_REDIS_URL=redis://redis:6379/0

# --- Безопасность ---
DOSTUK_ENV=prod
# openssl rand -base64 48
DOSTUK_JWT_SECRET=change-me-to-long-random-secret
DOSTUK_CORS_ORIGINS=["https://menu.dostuk.kg"]

# --- Файлы (MinIO) ---
DOSTUK_STORAGE_BACKEND=s3
DOSTUK_S3_ENDPOINT=http://minio:9000
DOSTUK_S3_BUCKET=dostuk
DOSTUK_S3_ACCESS_KEY=minio
DOSTUK_S3_SECRET_KEY=change-me-minio
DOSTUK_FILES_PUBLIC_BASE_URL=https://files.dostuk.kg

DOSTUK_MIN_APP_VERSION=3.0.0
